{
  "compilerOptions": {
    "target":           "ES2019",
    "module":           "CommonJS",
    "lib":              ["ES2019"],
    "jsx":              "react-native",

    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "allowSyntheticDefaultImports": true,

    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "outDir":           "./dist",
    "rootDir":          "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}